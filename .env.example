# --- Meta Model API -------------------------------------------------------
# Key from https://dev.meta.ai (never commit a real value; .env is git-ignored)
META_API_KEY=

# --- Run mode -------------------------------------------------------------
# live | replay | fake | demo   (default: replay - deterministic, free)
PW_MODE=replay

# --- Security -------------------------------------------------------------
# Access code required by the public demo (AGENTS.md §4, ADR-000)
PW_ACCESS_CODE=

# --- Cost control ---------------------------------------------------------
# Hard per-run spend cap in USD; the run aborts with a partial valid report
PW_SPEND_CAP_USD=3

# --- Storage --------------------------------------------------------------
# Where the filesystem run store writes runs/<run_id>/ (git-ignored)
PW_RUNS_DIR=runs

# --- Optional switches ----------------------------------------------------
# PW_DISABLE_ILLUSTRATIONS=1
# PW_DISABLE_VERIFIER=1
