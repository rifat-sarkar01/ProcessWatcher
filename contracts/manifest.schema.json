{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://process-watcher.dev/contracts/manifest.schema.json",
  "title": "Manifest",
  "description": "Run manifest and cost/eval provenance. Source of truth: docs/05_Schema.md §9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "finished_at",
    "mode",
    "inputs",
    "models",
    "config_sha256",
    "stages",
    "ledger",
    "dropped_candidates",
    "git_commit",
    "app_version"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "mode": { "enum": ["live", "replay", "fake", "demo"] },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_sha256", "sop_sha256", "step_graph_sha256", "edited_by_user"],
      "properties": {
        "video_sha256": { "$ref": "#/$defs/sha256" },
        "sop_sha256": { "$ref": "#/$defs/sha256" },
        "step_graph_sha256": { "$ref": "#/$defs/sha256" },
        "edited_by_user": { "type": "boolean" }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version_or_date", "endpoint"],
        "properties": {
          "name": { "enum": ["muse-wonder-1.0", "muse-image-1.0", "sam-3.1"] },
          "version_or_date": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "minLength": 1 }
        }
      }
    },
    "config_sha256": { "$ref": "#/$defs/sha256" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "started_at", "duration_ms", "cache_hit", "cost_usd"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "failed", "skipped"] },
          "started_at": { "$ref": "#/$defs/timestamp" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "cache_hit": { "type": "boolean" },
          "cost_usd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_usd", "by_model", "calls", "cache_hits", "spend_cap_usd", "cap_reached"],
      "properties": {
        "total_usd": { "type": "number", "minimum": 0 },
        "by_model": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "calls": { "type": "integer", "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "spend_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
        "cap_reached": { "type": "boolean" }
      }
    },
    "dropped_candidates": { "type": "integer", "minimum": 0 },
    "git_commit": { "type": "string", "minLength": 7 },
    "app_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "run_id": { "type": "string", "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
