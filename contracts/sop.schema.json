{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://process-watcher.dev/contracts/sop.schema.json",
  "title": "step_graph",
  "description": "Compiled SOP: ordered steps, ordering constraints and the SAM concept vocabulary. Source of truth: docs/05_Schema.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sop_id", "title", "source", "steps", "vocabulary"],
  "properties": {
    "schema_version": { "$ref": "#/$defs/semver" },
    "sop_id": {
      "type": "string",
      "pattern": "^sop_[0-9a-f]{8}$",
      "description": "sop_ + first 8 hex chars of the SOP text hash"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": { "enum": ["md", "txt", "pdf", "pasted"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pages": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/step" }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sam_concepts"],
      "properties": {
        "sam_concepts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "contains": { "const": "hand" },
          "description": "Generic noun phrases sent to SAM; `hand` is always present"
        },
        "zones": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Concepts used for enter/exit events"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Compile warnings (dropped hallucinated items etc.)"
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "idx", "text", "action", "tools", "parts", "ordering", "critical"],
      "properties": {
        "id": { "type": "string", "pattern": "^stp_\\d{2,}$" },
        "idx": { "type": "integer", "minimum": 1, "description": "1-based position in SOP order" },
        "text": { "type": "string", "minLength": 3, "maxLength": 400 },
        "action": { "type": "string", "minLength": 1, "maxLength": 60 },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "parts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "ordering": { "enum": ["strict", "unordered_group"] },
        "group_id": {
          "type": ["string", "null"],
          "pattern": "^grp_\\d{2}$",
          "description": "Required iff ordering is unordered_group"
        },
        "critical": { "type": "boolean", "description": "Explicit cues only" },
        "visual_check": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "What should be visible when the step is done"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ordering": { "const": "unordered_group" } }, "required": ["ordering"] },
          "then": { "required": ["group_id"], "properties": { "group_id": { "type": "string" } } },
          "else": {
            "properties": { "group_id": { "type": "null" } }
          }
        }
      ]
    }
  }
}
